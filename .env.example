# ---- ByteLabs environment ----
# Copy to `.env.local` and fill in your own values.

# ---- AI (ambient assistant + Brief parser) ----
# ByteLabs' AI needs exactly one provider key. If both are set, Anthropic wins.
# Without either, the assistant renders a "not configured" state and the Brief
# landing page returns a clear 503 on submit — the rest of the app keeps
# working.
#
# Anthropic native: goes through @anthropic-ai/sdk; the assistant keeps its
# enhancements (adaptive thinking, server-side fallback, refusal handling).
ANTHROPIC_API_KEY=
#
# OpenRouter (OpenAI-compatible): a plain HTTPS call, no extra dependency.
# Enhancements above degrade gracefully; the answer text is unchanged.
OPENROUTER_API_KEY=
#
# Model IDs are used verbatim, so pass the id your provider expects:
#   Anthropic:   "claude-opus-5", "claude-sonnet-5", "claude-haiku-4-5", ...
#   OpenRouter:  "anthropic/claude-sonnet-4.5", "anthropic/claude-opus-4.5", ...
# Defaults are provider-appropriate; override only if you want a different
# model, not to switch providers (the key does that).
BYTELABS_ASSIST_MODEL=
BYTELABS_BRIEF_MODEL=

# ---- Firebase (shared with Studying Kube) ----
# Same Firebase project as Studying Kube — one auth, two apps.
# Firebase Console -> Project settings -> General -> Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — only needed if ByteLabs ever stores files in Cloud Storage.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Server-side project ID for jose JWT verification.
# Falls back to NEXT_PUBLIC_FIREBASE_PROJECT_ID if unset.
FIREBASE_PROJECT_ID=

# ---- Studying Kube integration ----
# Base URL of the Kube API (no trailing slash).
# Auth uses the Firebase idToken from the handoff exchange — no shared secret needed.
KUBE_API_URL=https://studying-kube.vercel.app
